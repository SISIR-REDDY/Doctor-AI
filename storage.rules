rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function isDocument() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf';
    }
    function under25MB() {
      return request.resource.size < 25 * 1024 * 1024;
    }

    // Scanned bills, EOBs, denial letters, policies, medical records.
    match /document_scans/{userId}/{file=**} {
      allow read: if owner(userId);
      allow write: if owner(userId) && isDocument() && under25MB();
      allow delete: if owner(userId);
    }

    // Generic per-user uploads (PDF packets, letters, exports).
    match /uploads/{userId}/{file=**} {
      allow read: if owner(userId);
      allow write: if owner(userId) && under25MB();
      allow delete: if owner(userId);
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
